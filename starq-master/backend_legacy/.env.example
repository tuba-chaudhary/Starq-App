PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://starq:starq@localhost:5432/starq
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d

# Required for REAL Razorpay orders, signature verify, and webhooks.
# Dashboard: https://dashboard.razorpay.com/app/keys (Test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional SMS OTP (if unset, OTP endpoints return 503 — they do not fake success)
SMS_PROVIDER_API_KEY=

NODE_ENV=development
